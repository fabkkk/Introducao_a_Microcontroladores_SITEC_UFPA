// primeiro criamos uma variável para
// informar o pino que será usado
const int LED = 19;

// depois informamos o comportamento do pino
// no caso, queremos que ele seja uma saída
// pois assim conseguiremos controlar o LED
void setup() {
    pinMode(LED, OUTPUT);
}

// por fim, falamos em qual estado queremos que
// o LED fique: aceso (HIGH) ou apagado (LOW)
void loop() {
    digitalWrite(LED, HIGH);
}
